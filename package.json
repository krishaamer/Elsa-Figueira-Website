{
  "name": "elsa-workspace",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "workspaces": [
    "elsa-next",
    "elsa-meteor"
  ],
  "scripts": {
    "dev": "pnpm -C elsa-next dev",
    "dev:tp": "pnpm -C elsa-next dev --turbopack",
    "build": "pnpm -C elsa-next build",
    "start": "pnpm -C elsa-next start",
    "dev:next": "pnpm -C elsa-next dev",
    "build:next": "pnpm -C elsa-next build",
    "start:next": "pnpm -C elsa-next start",
    "dev:meteor": "pnpm -C elsa-meteor dev"
  }
}
